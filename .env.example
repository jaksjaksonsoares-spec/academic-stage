# ─────────────────────────────────────────────────────────────
# AcademiC Stage — variáveis de ambiente (exemplo, SEM credenciais)
# Copie para .env.local em desenvolvimento e configure na Vercel em produção.
# Nunca envie o arquivo .env.local para o GitHub.
# ─────────────────────────────────────────────────────────────

# URL pública do site (sem barra no final). Usada em links de e-mail e SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: SOMENTE no servidor. Usada para excluir contas.
# Não use o prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo da rotina diária que verifica os links úteis (Vercel Cron envia
# "Authorization: Bearer CRON_SECRET"). Gere com: openssl rand -hex 32
CRON_SECRET=

# Assistente pedagógico e análise de edital com IA (só no servidor).
# Sem esta chave, as funções de IA aparecem como "pendentes de configuração".
ANTHROPIC_API_KEY=
# Modelo usado (opcional). Padrão: claude-sonnet-5-5
AI_MODEL=

# ── Fase 4 (ainda não usadas pelo código) ───────────────────
# SUPPORT_EMAIL_TO=
# EMAIL_FROM=
# RESEND_API_KEY=
